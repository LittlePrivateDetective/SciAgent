# ============================================================
# SciAgent 环境变量模板
# 复制为 .env 后填写。所有密钥只允许放这里，禁止写进代码或提交仓库。
# ============================================================

# ---------- 大模型（OpenAI 兼容协议，可接任意国产模型）----------
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90

# 没有密钥时置 1：走内置假响应，整条链路仍可跑通（用于评测环境/断网演示）
LLM_MOCK=1

# ---------- 翻译模型（中英对照阅读）----------
# 必须是非推理模型；主模型带思维链会把输出预算吃光，逐段翻译返回空串。
# Function Calling 的工具路由决策也复用这个轻量模型。
TRANS_MODEL=qwen-flash
TRANS_BATCH=4
TRANS_WORKERS=3
TRANS_MAX_PAGES=60

# ---------- 视觉模型（扫描件 OCR 兜底，可选）----------
# 留空则只用 pytesseract；填了则优先用视觉大模型逐页识别
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=
VLM_MODEL=qwen3.5-ocr

# ---------- 本地模型（Ollama，呼应"本地模型部署加分"）----------
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# auto=有云模型用云、无则用本地；cloud=只用云；local=只用本地
LLM_ROUTE=auto

# ---------- 向量化 ----------
# api=走 OpenAI 兼容 /embeddings；local=本地 sentence-transformers；hash=零依赖兜底
EMB_PROVIDER=api
EMB_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMB_API_KEY=
EMB_MODEL=qwen3.7-text-embedding
EMB_DIM=1024
EMB_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 重排（Rerank，cross-encoder，显著提升"数值/术语"类问答命中）----------
# auto=有 key 就调、失败自动退回本地规则重排；api=强制；none=关闭
RERANK_PROVIDER=auto
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank

# ---------- 向量库 ----------
# auto=能导入 chromadb 就用，否则退到 SQLite+NumPy 暴力检索
VECTOR_BACKEND=auto
CHROMA_DIR=./data/chroma

# ---------- 检索参数 ----------
TOP_K=8
RERANK_TOP_N=4
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP=80
HYBRID_ALPHA=0.6

# ---------- 服务 ----------
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=120
LOG_LEVEL=INFO
# 评审专用口令；留空则不校验
DEMO_ACCESS_TOKEN=
