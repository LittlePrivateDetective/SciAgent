# ============================================================
# SciAgent 环境变量模板
# 复制为 .env 后填写。所有密钥只允许放这里，禁止写进代码或提交仓库。
# ============================================================

# ---------- 大模型（OpenAI 兼容协议，可接任意国产模型）----------
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=90

# 没有密钥时置 1：走内置假响应，整条链路仍可跑通（用于评测环境/断网演示）
LLM_MOCK=1

# ---------- 视觉模型（扫描件 OCR 兜底，可选）----------
# 留空则只用 pytesseract；填了则优先用视觉大模型逐页识别
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# ---------- 本地模型（Ollama，呼应"本地模型部署加分"）----------
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# auto=有云模型用云、无则用本地；cloud=只用云；local=只用本地
LLM_ROUTE=auto

# ---------- 向量化 ----------
# api=走 OpenAI 兼容 /embeddings；local=本地 sentence-transformers；hash=零依赖兜底
EMB_PROVIDER=hash
EMB_BASE_URL=https://api.siliconflow.cn/v1
EMB_API_KEY=
EMB_MODEL=BAAI/bge-m3
EMB_DIM=1024
EMB_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 向量库 ----------
# auto=能导入 chromadb 就用，否则退到 SQLite+NumPy 暴力检索
VECTOR_BACKEND=auto
CHROMA_DIR=./data/chroma

# ---------- 检索参数 ----------
TOP_K=8
RERANK_TOP_N=4
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP=80
HYBRID_ALPHA=0.6

# ---------- 服务 ----------
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=120
LOG_LEVEL=INFO
# 评审专用口令；留空则不校验
DEMO_ACCESS_TOKEN=
