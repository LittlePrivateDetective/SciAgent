# ============================================================
# SciAgent 环境变量模板
# 复制为 .env 后填写。所有密钥只允许放这里，禁止写进代码或提交仓库。
# ============================================================

# ---------- 大模型（OpenAI 兼容协议，可接任意国产模型）----------
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90
# 1=让推理模型先思考再答（更稳、更慢）；0=关掉思维链（同题 2.3s→1.4s，结论不变）
# 只对 DashScope 兼容层的推理模型有效，发不发这个字段取决于这里
LLM_THINKING=1

# 没有密钥时置 1：走内置假响应，整条链路仍可跑通（用于评测环境/断网演示）
LLM_MOCK=1

# ---------- 翻译模型（中英对照阅读）----------
# 必须是非推理模型；主模型带思维链会把输出预算吃光，逐段翻译返回空串。
# Function Calling 的工具路由决策也复用这个轻量模型。
TRANS_MODEL=qwen-flash
TRANS_BATCH=4
TRANS_WORKERS=3
TRANS_MAX_PAGES=60
# 整篇翻译（后台任务）用的加强模型；留空=与 TRANS_MODEL 相同
TRANS_MODEL_HQ=qwen3.8-max
# 写作 Copilot 专用模型：同样必须是"非推理"模型，否则思维链会吃光输出预算，
# 偶发返回四段全空（实测过）。flash 兼顾速度与质量。
WRITE_MODEL=qwen-flash
WRITE_MAX_TOKENS=6000

# ---------- 视觉模型（扫描件 OCR 兜底，可选）----------
# 留空则只用 pytesseract；填了则优先用视觉大模型逐页识别
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=
VLM_MODEL=qwen3.5-ocr

# ---------- 本地模型（Ollama，呼应"本地模型部署加分"）----------
# 本地模型通道：装好 Ollama 并 ollama pull qwen2.5:3b 后，把 ENABLED 置 1
# 再用 LLM_ROUTE=local 切过去。默认 auto 仍走云端（本地长上下文与并发有硬边界，
# 实测见 docs/本地模型实测.md）
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# auto=有云模型用云、无则用本地；cloud=只用云；local=只用本地
LLM_ROUTE=auto

# ---------- 向量化 ----------
# api=走 OpenAI 兼容 /embeddings；local=本地 sentence-transformers；hash=零依赖兜底
EMB_PROVIDER=api
EMB_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMB_API_KEY=
EMB_MODEL=qwen3.7-text-embedding
EMB_DIM=1024
EMB_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 重排（Rerank，cross-encoder，显著提升"数值/术语"类问答命中）----------
# auto=有 key 就调、失败自动退回本地规则重排；api=强制；none=关闭
RERANK_PROVIDER=auto
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank

# ---------- 向量库 ----------
# auto=能导入 chromadb 就用，否则退到 SQLite+NumPy 暴力检索
VECTOR_BACKEND=auto
CHROMA_DIR=./data/chroma

# ---------- 检索参数 ----------
TOP_K=8
RERANK_TOP_N=4
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP=80
HYBRID_ALPHA=0.6

# ---------- 服务 ----------
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=120
LOG_LEVEL=INFO
# 评审专用口令；留空则不校验
DEMO_ACCESS_TOKEN=

# 后台控制台口令（/admin）；留空 = 不鉴权，仅建议本机开发这样用
ADMIN_PASSWORD=

# ---------- 保活 ----------
# 每 5 分钟一次心跳：刷新数据库连接 + 让本地模型常驻显存。
# Ollama 默认 5 分钟没请求就卸载模型，下一次请求要重新加载（3B 实测 1.5–4s）；
# 心跳带 keep_alive=30m，冷启动 5876ms → 热态 138ms。
KEEPALIVE_ENABLED=1
KEEPALIVE_INTERVAL=300
KEEPALIVE_WARM_MODEL=1
# 云端预热会产生 token 费用（一天 288 次），只省首次 TLS 握手，默认关
KEEPALIVE_WARM_CLOUD=0

# ---------- 论文定期追踪（官方 1.4.2） ----------
# 默认关闭：没有外网或没配 key 的机器开着只会刷错误日志。
# 演示前在后台「论文追踪」组打开，或在这里改成 1。
DISCOVER_WATCH_ENABLED=0
DISCOVER_WATCH_INTERVAL=21600
DISCOVER_WATCH_DAYS=7
