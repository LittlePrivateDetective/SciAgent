.env
.venv/
__pycache__/
*.pyc
data/pdf/
# 根目录 pdf/ 是官方测试集原件（126 MB、39 篇），与 data/pdf 内容相同。
# 论文版权归原作者，只用于本地赛事测试，不进仓库；复现时把测试集放进 data/pdf 即可。
pdf/
data/uploads/
data/pages/
data/exports/
data/index/
data/*.pdf
.DS_Store

# 微调相关：训练环境、底座权重、训练数据与产物都不进仓库
# （6.2GB 的底座 + 2.4GB 的 torch，进仓库会把 clone 变成灾难）
ml/.venv/
ml/models/
ml/wheels/
data/sft/

# 评测产物：译文原文一堆，报告与结论在 docs/ 里，中间数据不重复进仓库
data/trans_eval/
data/*.log

# 运行期产物（体积大 / 每次运行都变），不进仓库
data/chroma/
data/*.db
data/*.db-shm
data/*.db-wal
data/logs/
data/_qa_*/
data/_qa_tmp/
data/_qa_clean/

# 浏览器自动化 profile 与截图缓存：只是临时缓存，不是证据本体
# 用不带斜杠的前缀通配：带斜杠只能匹配"已存在的目录"，
# 新增工具产生的路径在 git 眼里还无法判定类型，就会漏掉。
docs/qa/evidence/_profile*
docs/qa/evidence/_cdp_*
docs/qa/evidence/_p*
docs/qa/evidence/_qa_ui_check.js

# 技术文档的 HTML 是 PDF 的中间产物，由 scripts/build_doc.py 生成
# 提交物是 .md（源）与 .pdf（成稿），HTML 不进仓库
docs/技术文档.html
/科研小助手Agent-AI大模型.pdf

# 参赛材料与内部笔记：赛方需求文档、执行策略、自评分，不进公开仓库
_private/
.workbuddy/

# 提交包由 git archive 生成，代码一变就过期，不进仓库
dist/

# 云端发布目录：含真实 API Key 与 230MB 数据，绝不进仓库
deploy/
data/bm25_tokens.txt
data/bm25_tokens.tmp
_incoming/

# QA 隔离实例数据 / 运行日志 / 下载的第三方论文 PDF（版权，不进公开仓库）
# 复现用的清单与下载脚本保留在仓库：docs/qa/扩充文献清单.md、tests/corpus/*.py
tests/qa_run/data/
tests/qa_run/__pycache__/
tests/qa_run/*.log
tests/corpus/*.pdf
